#!/usr/bin/python3
"""Agent hook entry: `leitstand-hook <claude|codex> <session-start|prompt-submit|pre-tool-use|stop|session-end> [--max-seconds N]`.

Exit 2 wakes an idle asyncRewake session, so it is returned only for a real Claude Listener event;
Codex receives the wake text on stdout with exit 0.
Argument errors, an older leitstand.py or any unexpected failure exit 1, never 2.
"""
from pathlib import Path
import sys
from types import SimpleNamespace

sys.path.insert(0, str(Path(__file__).resolve().parent))

EVENTS = ("session-start", "prompt-submit", "pre-tool-use", "stop", "session-end", "prompt-activity", "stop-activity")


def parse(argv, providers):
    if len(argv) not in (2, 4) or argv[0] not in providers or argv[1] not in EVENTS:
        raise ValueError("usage")
    max_seconds = 86000
    if len(argv) == 4:
        if argv[2] != "--max-seconds":
            raise ValueError("usage")
        max_seconds = int(argv[3])
    return SimpleNamespace(provider=argv[0], event=argv[1], max_seconds=max_seconds)


def run(argv, client=None):
    try:
        import leitstand
        code = leitstand.hook(parse(argv, leitstand.HOOK_PROVIDERS), client)
        return code if code in (0, 2) else 1
    except SystemExit as error:
        return 0 if error.code in (None, 0) else 1
    except BaseException:
        return 1


if __name__ == "__main__":
    sys.exit(run(sys.argv[1:]))
